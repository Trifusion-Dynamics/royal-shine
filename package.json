{
  "name": "royal-shine",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently \"pnpm --filter royal-shine-frontend dev\" \"pnpm --filter royal-shine-backend start:dev\"",
    "dev:frontend": "pnpm --filter royal-shine-frontend dev",
    "dev:backend": "pnpm --filter royal-shine-backend start:dev",
    "build": "pnpm --filter royal-shine-frontend build && pnpm --filter royal-shine-backend build",
    "lint": "pnpm --filter frontend lint && pnpm --filter backend lint",
    "test": "pnpm --filter backend test",
    "prisma:push": "pnpm --filter backend prisma:push",
    "prisma:migrate": "pnpm --filter backend prisma:migrate",
    "prisma:studio": "pnpm --filter backend exec prisma studio"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
